<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness (no test framework): inflater round trip against .NET's DeflateStream and
       random seeks through checkpoints. dotnet run -c Release with optional megabytes argument; prints ALL PASSED. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeekableDeflate\SeekableDeflate.csproj" />
  </ItemGroup>

</Project>
